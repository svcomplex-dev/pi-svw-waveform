#!/bin/sh
set -eu

required_email="code@svcomplex.ai"
author_ident=$(git var GIT_AUTHOR_IDENT)
committer_ident=$(git var GIT_COMMITTER_IDENT)

case "$author_ident" in
  *"<$required_email>"*) ;;
  *)
    printf '%s\n' "error: Git author email must be $required_email" >&2
    exit 1
    ;;
esac

case "$committer_ident" in
  *"<$required_email>"*) ;;
  *)
    printf '%s\n' "error: Git committer email must be $required_email" >&2
    exit 1
    ;;
esac
