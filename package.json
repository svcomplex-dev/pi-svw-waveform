{
  "name": "pi-svw-waveform",
  "version": "0.1.12",
  "description": "Pi package for native svw waveform inspection and terminal rendering",
  "svwRelease": "release-0.1.4",
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/install-svw.mjs",
    "bootstrap": "node ./scripts/install-svw.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "smoke:pi": "node ./scripts/smoke-pi.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "systemverilog",
    "waveform",
    "vcd",
    "fst",
    "eda"
  ],
  "author": "SVComplex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svcomplex-dev/pi-svw-waveform.git"
  },
  "bugs": {
    "url": "https://github.com/svcomplex-dev/pi-svw-waveform/issues"
  },
  "homepage": "https://github.com/svcomplex-dev/pi-svw-waveform#readme",
  "files": [
    "extensions",
    "skills",
    "scripts/install-svw.mjs",
    "scripts/install-svw.sh",
    "svw-source.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/svcomplex-dev/svw/main/features-pi-agent.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
